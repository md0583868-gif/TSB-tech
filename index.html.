<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>TSB Tech</title>

<style>
*{box-sizing:border-box;margin:0;padding:0}
body{
font-family:Arial,sans-serif;
background:#050914;
color:white;
line-height:1.6
}
nav{
padding:18px 7%;
display:flex;
justify-content:space-between;
align-items:center;
border-bottom:1px solid #1c2940;
background:#070b14
}
.logo{font-size:25px;font-weight:bold}
.logo span{color:#1680ff}
nav a{color:white;text-decoration:none;margin-left:20px}
.btn{
display:inline-block;
background:#1677ff;
color:white;
padding:12px 20px;
border-radius:8px;
text-decoration:none;
font-weight:bold;
border:0
}
.hero{
padding:90px 7%;
display:grid;
grid-template-columns:1fr 1fr;
gap:40px;
align-items:center;
background:radial-gradient(circle at 80%,#103b85,transparent 40%)
}
.badge{
color:#48a5ff;
border:1px solid #245080;
padding:7px 14px;
border-radius:30px
}
h1{
font-size:clamp(42px,6vw,70px);
line-height:1.05;
margin:25px 0
}
.blue{color:#1677ff}
.hero p{color:#aab5c8;font-size:18px;margin-bottom:25px}
.buttons{display:flex;gap:12px;flex-wrap:wrap}
.code{
background:#030710;
border:1px solid #20385d;
border-radius:18px;
padding:30px;
font-family:monospace;
color:#6fc1ff;
box-shadow:0 20px 60px #001d55
}
section{padding:65px 7%}
h2{font-size:32px;margin-bottom:25px}
.grid{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:18px
}
.card{
background:#0b1220;
border:1px solid #1d2c44;
border-radius:15px;
padding:25px
}
.card:hover{border-color:#1680ff}
.icon{font-size:35px}
.card h3{margin:10px 0}
.card p{color:#9eabc0}
.small{display:block;color:#3896ff;margin-top:15px;font-weight:bold}
.path{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:18px
}
.step{
background:#0b1220;
border:1px solid #1d2c44;
border-radius:15px;
padding:25px
}
.number{
width:40px;height:40px;
display:grid;place-items:center;
background:#1677ff;
border-radius:50%;
font-weight:bold;
margin-bottom:15px
}
.exercise{
background:#0b1220;
border:1px solid #1d2c44;
padding:25px;
border-radius:15px
}
.answer{
display:block;
width:100%;
margin:10px 0;
padding:12px;
background:#101b2d;
border:1px solid #2a3c58;
color:white;
border-radius:8px;
text-align:left
}
.answer:hover{border-color:#1680ff}
footer{
padding:30px;
text-align:center;
border-top:1px solid #1c2940;
color:#7f8ba0
}
@media(max-width:800px){
.hero{grid-template-columns:1fr}
.grid,.path{grid-template-columns:1fr}
nav div:nth-child(2){display:none}
}
</style>
</head>

<body>

<nav>
<div class="logo"><span>TSB</span> Tech</div>
<div>
